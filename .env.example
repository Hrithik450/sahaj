# Supabase transaction pooler (port 6543): app + migrations
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

GEMINI_API_KEY=
# Simplifier uses lite model by default (fast). Chat/simplify companion use GEMINI_TEXT_MODEL.
GEMINI_SIMPLIFY_MODEL=gemini-3.1-flash-lite
GEMINI_TEXT_MODEL=gemini-3.6-flash
# Help chatbot only — keep on lite model (do not use GEMINI_TEXT_MODEL here)
GEMINI_HELP_MODEL=gemini-3.1-flash-lite
SARVAM_API_KEY=
